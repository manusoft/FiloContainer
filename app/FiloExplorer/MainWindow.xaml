<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FiloExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FiloExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Filo Container">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid>
        <!-- Custom Title Bar Area -->
        <Grid x:Name="AppTitleBar" 
              Height="48" 
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Icon + Title -->
            <StackPanel Orientation="Horizontal" 
                        Spacing="12" 
                        Margin="16,0,0,0" 
                        VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" 
                       Width="24" Height="24"/>
                <TextBlock x:Name="AppTitleText" 
                           Text="Filo Explorer" 
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- MenuBar will sit below or integrated -->
        </Grid>

        <Grid Margin="0,38,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- MenuBar -->
                <RowDefinition Height="*"/>
                <!-- Content Frame -->
            </Grid.RowDefinitions>

            <!-- Modern MenuBar -->
            <MenuBar Grid.Row="0" 
                     Margin="12,8,12,0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem x:Name="menuFileNew" 
                                    Text="New Container" 
                                    Icon="Document" 
                                    Click="menuFileNew_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="menuFileOpen" 
                                    Text="Open Container..." 
                                    Icon="OpenFile" 
                                    Click="menuFileOpen_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="menuFileExit" 
                                    Text="Exit" 
                                    Click="menuFileExit_Click"/>
                </MenuBarItem>

                <MenuBarItem Title="Help">
                    <MenuFlyoutItem x:Name="menuHelpView" 
                                    Text="View Help" 
                                    Icon="Help" 
                                    Click="menuHelpView_Click"/>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="menuHelpAbout" 
                                    Text="About Filo Explorer" 
                                    Click="menuHelpAbout_Click"/>
                </MenuBarItem>
            </MenuBar>

            <!-- Main Content Frame -->
            <Frame x:Name="RootFrame" 
                   Grid.Row="1"
                   Padding="0"/>
        </Grid>
    </Grid>
</Window>
