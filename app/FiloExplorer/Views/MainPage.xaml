<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FiloExplorer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FiloExplorer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid >
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        MaxWidth="800"
                        Padding="40">

                <!-- Hero Section -->
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" 
                            CornerRadius="60" 
                            Background="DeepSkyBlue"
                            HorizontalAlignment="Center">
                        <Image Source="/Assets/AppLogo.png"  Height="128" Width="128" Margin="-7"/>
                    </Border>

                    <TextBlock Text="Filo Explorer" 
                               FontSize="42" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Secure • Fast • Beautiful" 
                               FontSize="18" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Action Cards -->
                <Grid ColumnSpacing="24" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Create New Card -->
                    <Button x:Name="CreateCard" 
                            Click="New_Click"
                            Padding="32"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="20" HorizontalAlignment="Center" >
                            <FontIcon Glyph="&#xE710;" 
                                      FontSize="48" 
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Create Filo Container" 
                                       FontSize="20" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Build a new encrypted .filo archive from files and folders" 
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Open Existing Card -->
                    <Button Grid.Column="1"                        
                            x:Name="OpenCard" 
                            Click="Open_Click"
                            Padding="32"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="20" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" 
                                      FontSize="48" 
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Open Filo Container" 
                                       FontSize="20" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="View, preview, and extract files from an existing .filo archive" 
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Recent or Tips -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        Padding="24" 
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Quick Tips" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="• Use Ctrl+N to quickly create a new container" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="• Supported formats: Images, Videos, Documents, and more" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="• All data is encrypted with AES-256 when password is set" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
