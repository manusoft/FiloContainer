<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FiloExplorer.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FiloExplorer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top CommandBar with Back Button -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Back" 
                              Label="Back" 
                              Click="BackButton_Click"/>
            </CommandBar.PrimaryCommands>

            <CommandBar.Content>
                <TextBlock Text="Help &amp; Support" 
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Margin="0,0,0,0"
                           VerticalAlignment="Center"/>
            </CommandBar.Content>
        </CommandBar>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="40" MaxWidth="900" HorizontalAlignment="Left">

                <!-- Introduction -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Welcome to Filo Explorer" 
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Filo Explorer is a modern, secure container application built on the Filo 1.1.0 library. It allows you to create encrypted archives (.filo files) and securely view, preview, and extract their contents."
                               TextWrapping="Wrap"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                </StackPanel>

                <!-- Core Capabilities using Filo Package -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Filo Package Capabilities" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="24" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Create -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="24" CornerRadius="8">
                            <StackPanel Spacing="16">
                                <FontIcon Glyph="&#xE710;" FontSize="36" 
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Create Secure Container" FontWeight="SemiBold" FontSize="18"/>
                                <TextBlock Text="Using FiloWriter with AES-256 encryption support. Add individual files or entire folders recursively. Optional password protection via WithPassword()." 
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- View -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="24" CornerRadius="8">
                            <StackPanel Spacing="16">
                                <FontIcon Glyph="&#xE8A5;" FontSize="36" 
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Browse &amp; Preview" FontWeight="SemiBold" FontSize="18"/>
                                <TextBlock Text="Powered by FiloReader and FiloStream. Supports fast preview of images, video, and audio without full extraction. ListFiles() provides complete directory structure." 
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- How to Use -->
                <StackPanel Spacing="20">
                    <TextBlock Text="How to Use" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="20" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="12">
                            <TextBlock Text="1. Creating a New Container" FontWeight="SemiBold"/>
                            <TextBlock Text="• Click 'Create Filo Container' from the main menu or home screen&#x0a;• Add files and folders&#x0a;• Optionally set a password in the right pane&#x0a;• Click 'Create Filo container'" 
                                       TextWrapping="Wrap" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="12" Grid.Row="1">
                            <TextBlock Text="2. Opening and Viewing" FontWeight="SemiBold"/>
                            <TextBlock Text="• Click 'Open Filo Container'&#x0a;• Select a .filo file&#x0a;• Enter password if the container is encrypted (AES256 header)&#x0a;• Browse folders and preview files directly" 
                                       TextWrapping="Wrap" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Features -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Key Features" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="#00B7C3"/>
                                <StackPanel>
                                    <TextBlock Text="AES-256 Encryption" FontWeight="SemiBold"/>
                                    <TextBlock Text="Strong encryption for your sensitive files" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE8A7;" FontSize="24" Foreground="#00B7C3"/>
                                <StackPanel>
                                    <TextBlock Text="Rich Preview" FontWeight="SemiBold"/>
                                    <TextBlock Text="Preview images, videos, and audio directly" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="20" Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="#00B7C3"/>
                                <StackPanel>
                                    <TextBlock Text="Fluent Design" FontWeight="SemiBold"/>
                                    <TextBlock Text="Modern WinUI 3 interface with Mica &amp; Acrylic" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="#00B7C3"/>
                                <StackPanel>
                                    <TextBlock Text="Easy Extraction" FontWeight="SemiBold"/>
                                    <TextBlock Text="Extract individual files or entire folders" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Keyboard Shortcuts -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Keyboard Shortcuts" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            Padding="24" CornerRadius="8">
                        <Grid ColumnSpacing="40" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Ctrl + N" FontFamily="Consolas" FontWeight="SemiBold"/>
                                <TextBlock Text="Ctrl + O" FontFamily="Consolas" FontWeight="SemiBold"/>
                                <TextBlock Text="Alt + Left Arrow" FontFamily="Consolas" FontWeight="SemiBold"/>
                                <TextBlock Text="F1" FontFamily="Consolas" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Spacing="12" Grid.Column="1">
                                <TextBlock Text="Create new container"/>
                                <TextBlock Text="Open existing container"/>
                                <TextBlock Text="Go back"/>
                                <TextBlock Text="Open Help"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        Padding="24" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="About Filo 1.1.0" FontWeight="SemiBold"/>
                        <TextBlock Text="Filo is a lightweight, high-performance container format with built-in AES-256 encryption support. FiloReader and FiloWriter provide simple and secure APIs for working with .filo containers."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Support -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Need More Help?" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="If you have any questions or encounter issues, feel free to reach out." 
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <HyperlinkButton Content="Contact Support" 
                                     NavigateUri="mailto:support@yourdomain.com"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
